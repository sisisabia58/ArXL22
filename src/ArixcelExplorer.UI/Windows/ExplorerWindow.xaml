<Window x:Class="ArixcelExplorer.UI.Windows.ExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:ArixcelExplorer.Core.Settings;assembly=ArixcelExplorer.Core"
        Title="EXLerate Explorer"
        Height="{x:Static settings:ExplorerChrome.ExplorerHeight}"
        Width="{x:Static settings:ExplorerChrome.ExplorerWidth}"
        MinHeight="{x:Static settings:ExplorerChrome.ExplorerMinHeight}"
        MinWidth="{x:Static settings:ExplorerChrome.ExplorerMinWidth}"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        Topmost="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ArixcelExplorer.UI;component/Themes/ArixcelTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="6">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ListView x:Name="TreeGrid"
              Grid.Row="0"
              Style="{StaticResource ArixcelListViewStyle}"
              ItemContainerStyle="{StaticResource ArixcelListRowStyle}"
              ItemsSource="{Binding Rows}"
              SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
              SelectionMode="Extended"
              SelectionChanged="TreeGrid_SelectionChanged">
      <ListView.View>
        <GridView AllowsColumnReorder="False">
          <GridViewColumn Header="Element" Width="{x:Static settings:ExplorerChrome.ElementWidth}">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding ComponentDisplay}"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           VerticalAlignment="Center" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="Info" DisplayMemberBinding="{Binding Info}"
                          Width="{x:Static settings:ExplorerChrome.InfoWidth}" />
          <GridViewColumn Header="Value" DisplayMemberBinding="{Binding Value}"
                          Width="{x:Static settings:ExplorerChrome.ValueWidth}" />
          <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}"
                          Width="{x:Static settings:ExplorerChrome.LocationWidth}" />
        </GridView>
      </ListView.View>
    </ListView>

    <Border Grid.Row="1"
            Margin="0,4,0,0"
            Padding="3,1"
            BorderBrush="{StaticResource ArixcelBorderBrush}"
            BorderThickness="1"
            Background="White"
            Height="{x:Static settings:ExplorerChrome.FormulaPaneHeight}">
      <TextBox x:Name="FormulaBox"
               Text="{Binding FormulaText, Mode=OneWay}"
               IsReadOnly="True"
               TextWrapping="Wrap"
               FontFamily="Segoe UI"
               FontSize="11"
               BorderThickness="0"
               Background="Transparent"
               VerticalContentAlignment="Center"
               Padding="0"
               PreviewMouseLeftButtonDown="FormulaBox_PreviewMouseLeftButtonDown" />
    </Border>

    <Button Grid.Row="2"
            Content="OK"
            HorizontalAlignment="Right"
            Margin="0,6,0,0"
            Width="{x:Static settings:ExplorerChrome.OkButtonWidth}"
            Height="{x:Static settings:ExplorerChrome.OkButtonHeight}"
            Click="Ok_Click" />
  </Grid>
</Window>
