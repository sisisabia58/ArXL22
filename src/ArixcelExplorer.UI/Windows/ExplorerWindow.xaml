<Window x:Class="ArixcelExplorer.UI.Windows.ExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:ArixcelExplorer.Core.Settings;assembly=ArixcelExplorer.Core"
        Title="EXLerate Explorer"
        Height="{x:Static settings:ExplorerChrome.ExplorerHeight}"
        Width="{x:Static settings:ExplorerChrome.ExplorerWidth}"
        MinHeight="{x:Static settings:ExplorerChrome.ExplorerMinHeight}"
        MinWidth="{x:Static settings:ExplorerChrome.ExplorerMinWidth}"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        Topmost="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ArixcelExplorer.UI;component/Themes/ArixcelTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="6">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ListView x:Name="TreeGrid"
              Grid.Row="0"
              Style="{StaticResource ArixcelListViewStyle}"
              ItemContainerStyle="{StaticResource ArixcelListRowStyle}"
              ItemsSource="{Binding Rows}"
              SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
              SelectionMode="Extended"
              KeyboardNavigation.DirectionalNavigation="None"
              PreviewKeyDown="Window_PreviewKeyDown"
              SelectionChanged="TreeGrid_SelectionChanged"
              MouseDoubleClick="TreeGrid_MouseDoubleClick">
      <ListView.View>
        <GridView AllowsColumnReorder="False">
          <GridViewColumn Header="Element" Width="{x:Static settings:ExplorerChrome.ElementWidth}">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Width="{Binding IndentWidth}" />
                  <Border Width="{x:Static settings:ExplorerTreeChrome.GlyphSize}"
                          Height="{x:Static settings:ExplorerTreeChrome.GlyphSize}"
                          Margin="0,0,4,0"
                          BorderBrush="#808080"
                          BorderThickness="1"
                          Background="#F8F8F8"
                          Cursor="Hand"
                          PreviewMouseLeftButtonDown="TreeGlyph_PreviewMouseLeftButtonDown">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Hidden" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasChildren}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Glyph}"
                               FontFamily="Segoe UI"
                               FontSize="10"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="{Binding Component}"
                             FontFamily="Segoe UI"
                             FontSize="11"
                             VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="Info" DisplayMemberBinding="{Binding Info}"
                          Width="{x:Static settings:ExplorerChrome.InfoWidth}" />
          <GridViewColumn Header="Value" DisplayMemberBinding="{Binding Value}"
                          Width="{x:Static settings:ExplorerChrome.ValueWidth}" />
          <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}"
                          Width="{x:Static settings:ExplorerChrome.LocationWidth}" />
        </GridView>
      </ListView.View>
    </ListView>

    <Border Grid.Row="1"
            Margin="0,4,0,0"
            Padding="3,1"
            BorderBrush="{StaticResource ArixcelBorderBrush}"
            BorderThickness="1"
            Background="White"
            Height="{x:Static settings:ExplorerChrome.FormulaPaneHeight}">
      <RichTextBox x:Name="FormulaBox"
                   IsReadOnly="True"
                   IsDocumentEnabled="True"
                   AcceptsReturn="False"
                   FontFamily="Segoe UI"
                   FontSize="11"
                   BorderThickness="0"
                   Background="Transparent"
                   Padding="0"
                   VerticalScrollBarVisibility="Disabled"
                   HorizontalScrollBarVisibility="Disabled"
                   PreviewMouseLeftButtonDown="FormulaBox_PreviewMouseLeftButtonDown" />
    </Border>

    <Button Grid.Row="2"
            Content="OK"
            HorizontalAlignment="Right"
            Margin="0,6,0,0"
            Width="{x:Static settings:ExplorerChrome.OkButtonWidth}"
            Height="{x:Static settings:ExplorerChrome.OkButtonHeight}"
            Click="Ok_Click" />
  </Grid>
</Window>
