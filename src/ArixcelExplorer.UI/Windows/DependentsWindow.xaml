<Window x:Class="ArixcelExplorer.UI.Windows.DependentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arixcel Explorer — Dependents"
        Height="480"
        Width="440"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="Arixcel Explorer — Dependents"
               FontSize="15"
               FontWeight="SemiBold"
               Margin="0,0,0,8" />

    <TextBlock x:Name="SourceSummaryText"
               Grid.Row="1"
               Margin="0,0,0,8"
               TextWrapping="Wrap"
               Foreground="#444" />

    <Border Grid.Row="2" BorderBrush="#E3E3E3" BorderThickness="1" CornerRadius="4">
      <DataGrid x:Name="DependentsGrid"
                AutoGenerateColumns="False"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                IsReadOnly="True"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                RowHeaderWidth="0"
                SelectionChanged="DependentsGrid_SelectionChanged">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Cell" Binding="{Binding Address}" Width="*" />
          <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="60" />
          <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="100" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <TextBlock x:Name="StatusText"
               Grid.Row="3"
               Margin="0,6,0,0"
               FontSize="11"
               Foreground="#555" />
  </Grid>
</Window>
